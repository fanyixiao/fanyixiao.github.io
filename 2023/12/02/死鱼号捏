                elements.potionExpGain.textContent = `+${expGain}`;
                elements.potionUseNotification.style.opacity = '1';
                elements.potionUseNotification.style.pointerEvents = 'auto';
                elements.potionUseNotification.style.scale = '1';
                
                setTimeout(() => {
                    elements.potionUseNotification.style.opacity = '0';
                    elements.potionUseNotification.style.pointerEvents = 'none';
                    elements.potionUseNotification.style.scale = '0.9';
                }, 2000);
                
                // 更新UI
                renderBackpack();
                updateUI();
            }
        }
        
        // 尝试掉落丹药
        function tryDropPotion(sceneIndex) {
            const scene = scenes[sceneIndex];
            const chances = scene.potionChances;
            const random = Math.random() * 100; // 0-100的随机数
            
            let total = 0;
            for (const [type, chance] of Object.entries(chances)) {
                total += chance;
                if (random <= total && chance > 0) {
                    // 确定倍率和随机选择一个同类型丹药
                    const potionsOfType = potionData[type];
                    if (potionsOfType && potionsOfType.length > 0) {
                        const potionIndex = Math.floor(Math.random() * potionsOfType.length);
                        const selectedPotion = potionsOfType[potionIndex];
                        
                        // 添加到背包
                        addPotionToBackpack({ 
                            type, 
                            ...selectedPotion
                        });
                    }
                    return;
                }
            }
        }
        
        // 更新经验获取速率（考虑倍率）
        function updateExpRates() {
            gameState.expRate = Math.floor(gameState.baseExpRate * gameState.expMultiplier);
            gameState.clickExpAmount = Math.floor(gameState.baseClickExpAmount * gameState.expMultiplier);
        }
        
        // 更新UI显示
        function updateUI() {
            elements.levelBadge.textContent = gameState.level;
            elements.currentExp.textContent = gameState.currentExp;
            elements.totalExp.textContent = gameState.totalExp;
            elements.expToNext.textContent = `/ ${gameState.expToNext.toLocaleString()}`;
            elements.expRate.textContent = gameState.expRate;
            elements.clickExpAmount.textContent = gameState.clickExpAmount;
            elements.autoUpgradeCost.textContent = gameState.autoUpgradeCost.toLocaleString();
            elements.clickUpgradeCost.textContent = gameState.clickUpgradeCost.toLocaleString();
            
            // 计算经验条百分比（限制在100%以内）
            const expPercentage = Math.min((gameState.currentExp / gameState.expToNext) * 100, 100);
            elements.expBar.style.width = `${expPercentage}%`;
            
            // 当经验快满时添加发光效果
            if (expPercentage > 80) {
                elements.expBar.classList.add('exp-glow');
            } else {
                elements.expBar.classList.remove('exp-glow');
            }
            
            // 检查角色升级按钮是否可点击
            if (gameState.currentExp >= gameState.expToNext) {
                elements.playerUpgradeButton.classList.remove('btn-disabled', 'hover:bg-purple-700');
                elements.playerUpgradeButton.classList.add('btn-ready');
                elements.playerUpgradeButton.disabled = false;
            } else {
                elements.playerUpgradeButton.classList.add('btn-disabled', 'hover:bg-purple-700');
                elements.playerUpgradeButton.classList.remove('btn-ready');
                elements.playerUpgradeButton.disabled = true;
            }
            
            // 检查自动升级按钮是否可点击
            if (gameState.totalExp >= gameState.autoUpgradeCost) {
                elements.upgradeAutoButton.classList.remove('btn-disabled', 'hover:bg-blue-600');
                elements.upgradeAutoButton.disabled = false;
            } else {
                elements.upgradeAutoButton.classList.add('btn-disabled', 'hover:bg-blue-600');
                elements.upgradeAutoButton.disabled = true;
            }
            
            // 检查点击升级按钮是否可点击
            if (gameState.totalExp >= gameState.clickUpgradeCost) {
                elements.upgradeClickButton.classList.remove('btn-disabled', 'hover:bg-pink-600');
                elements.upgradeClickButton.disabled = false;
            } else {
                elements.upgradeClickButton.classList.add('btn-disabled', 'hover:bg-pink-600');
                elements.upgradeClickButton.disabled = true;
            }
            
            // 检查是否有新场景解锁
            checkSceneUnlocks();
        }
        
        // 检查是否有新场景解锁
        function checkSceneUnlocks() {
            const previouslyUnlocked = scenes.filter(s => s.level <= gameState.level - 1).length;
            const newlyUnlocked = scenes.filter(s => s.level <= gameState.level).length;
            
            if (newlyUnlocked > previouslyUnlocked) {
                const unlockedScene = scenes[newlyUnlocked - 1];
                showSceneUnlockEffect(unlockedScene);
                
                // 如果解锁的场景不在当前页，自动切换到对应页
                const scenePage = Math.ceil(newlyUnlocked / 10);
                if (scenePage !== gameState.currentScenePage) {
                    gameState.currentScenePage = scenePage;
                    renderScenePage(scenePage);
                } else {
                    // 更新当前页的场景按钮状态
                    document.querySelectorAll('.scene-btn').forEach((btn, i) => {
                        const btnIndex = parseInt(btn.dataset.index);
                        if (btnIndex === newlyUnlocked - 1) {
                            btn.classList.remove('scene-locked');
                            btn.disabled = false;
                        }
                    });
                }
            }
        }
        
        // 显示场景解锁效果
        function showSceneUnlockEffect(scene) {
            elements.unlockedScene.textContent = scene.name;
            elements.sceneUnlockNotification.style.opacity = '1';
            elements.sceneUnlockNotification.style.pointerEvents = 'auto';
            elements.sceneUnlockNotification.style.scale = '1';
            
            setTimeout(() => {
                elements.sceneUnlockNotification.style.opacity = '0';
                elements.sceneUnlockNotification.style.pointerEvents = 'none';
                elements.sceneUnlockNotification.style.scale = '0.9';
            }, 3000);
        }
        
        // 获得经验（考虑倍率）
        function gainExp(amount, fromClick = false) {
            const actualAmount = Math.floor(amount * gameState.expMultiplier);
            gameState.currentExp += actualAmount;
            gameState.totalExp += actualAmount;
            
            // 如果点击获取经验，显示浮动文字并尝试掉落丹药
            if (fromClick) {
                showFloatingExp(actualAmount);
                tryDropPotion(gameState.currentScene);
            }
            
            // 更新UI
            updateUI();
        }
        
        // 玩家手动升级 - 每次升级后基础经验获取翻3倍
        function playerUpgrade() {
            if (gameState.currentExp >= gameState.expToNext) {
                // 升级前的等级
                const oldLevel = gameState.level;
                
                // 升级
                gameState.level++;
                gameState.currentExp -= gameState.expToNext;
                
                // 升级所需经验100倍增长
                gameState.expToNext *= 188;
                
                // 角色升级后，基础自动和点击经验翻3倍
                gameState.baseExpRate *= 3;
                gameState.baseClickExpAmount *= 3;
                
                // 重新计算考虑倍率后的经验获取量
                updateExpRates();
                
                // 显示升级动画和提示
                showLevelUpEffect();
                
                // 更新UI
                updateUI();
            }
        }
        
        // 升级自动获取经验（每次翻倍）
        function upgradeAutoExp() {
            if (gameState.totalExp >= gameState.autoUpgradeCost) {
                // 消耗总经验
                gameState.totalExp -= gameState.autoUpgradeCost;
                
                // 提升基础自动获取速率（每次升级翻倍）
                gameState.baseExpRate *= 1.88;
                
                // 重新计算考虑倍率后的经验获取量
                updateExpRates();
                
                // 计算下次升级消耗（每次翻倍）
                gameState.autoUpgradeCost *= 2;
                
                // 显示升级效果
                showUpgradeEffect("自动获取");
                
                // 更新UI
                updateUI();
            }
        }
        
        // 升级点击获取经验（每次翻倍）
        function upgradeClickExp() {
            if (gameState.totalExp >= gameState.clickUpgradeCost) {
                // 消耗总经验
                gameState.totalExp -= gameState.clickUpgradeCost;
                
                // 提升基础点击获取量（每次升级翻倍）
                gameState.baseClickExpAmount *= 2;
                
                // 重新计算考虑倍率后的经验获取量
                updateExpRates();
                
                // 计算下次升级消耗（每次翻倍）
                gameState.clickUpgradeCost *= 2;
                
                // 显示升级效果
                showUpgradeEffect("点击获取");
                
                // 更新UI
                updateUI();
            }
        }
        
        // 显示升级效果
        function showLevelUpEffect() {
            // 等级徽章动画
            elements.levelBadge.classList.add('animate-level-up');
            setTimeout(() => {
                elements.levelBadge.classList.remove('animate-level-up');
            }, 1000);
            
            // 显示升级通知
            elements.newLevelText.textContent = gameState.level;
            elements.levelUpNotification.style.opacity = '1';
            elements.levelUpNotification.style.pointerEvents = 'auto';
            elements.levelUpNotification.style.scale = '1';
            
            setTimeout(() => {
                elements.levelUpNotification.style.opacity = '0';
                elements.levelUpNotification.style.pointerEvents = 'none';
                elements.levelUpNotification.style.scale = '0.9';
            }, 2000);
        }
        
        // 显示强化效果
        function showUpgradeEffect(type) {
            // 按钮动画
            if (type === "自动获取") {
                elements.upgradeAutoButton.classList.add('animate-upgrade');
                setTimeout(() => {
                    elements.upgradeAutoButton.classList.remove('animate-upgrade');
                }, 500);
            } else {
                elements.upgradeClickButton.classList.add('animate-upgrade');
                setTimeout(() => {
                    elements.upgradeClickButton.classList.remove('animate-upgrade');
                }, 500);
            }
            
            // 显示强化通知
            elements.upgradeType.textContent = type;
            elements.upgradeNotification.style.opacity = '1';
            elements.upgradeNotification.style.pointerEvents = 'auto';
            elements.upgradeNotification.style.scale = '1';
            
            setTimeout(() => {
                elements.upgradeNotification.style.opacity = '0';
                elements.upgradeNotification.style.pointerEvents = 'none';
                elements.upgradeNotification.style.scale = '0.9';
            }, 1500);
        }
        
        // 显示浮动经验文字
        function showFloatingExp(amount) {
            const floatElement = document.createElement('div');
            floatElement.className = 'absolute text-secondary font-bold transition-all duration-1000 ease-out';
            floatElement.textContent = `+${amount.toLocaleString()}`;
            
            // 获取按钮位置，在按钮上方随机位置显示
            const rect = elements.expButton.getBoundingClientRect();
            const x = rect.left + window.scrollX + Math.random() * rect.width - 20;
            const y = rect.top + window.scrollY - 20;
            
            floatElement.style.left = `${x}px`;
            floatElement.style.top = `${y}px`;
            floatElement.style.opacity = '1';
            
            elements.floatingExpContainer.appendChild(floatElement);
            
            // 动画：上移并淡出
            setTimeout(() => {
                floatElement.style.transform = 'translateY(-30px)';
                floatElement.style.opacity = '0';
                
                // 移除元素
                setTimeout(() => {
                    elements.floatingExpContainer.removeChild(floatElement);
                }, 1000);
            }, 10);
        }
        
        // 自动获取经验
        function startAutoExpGain() {
            setInterval(() => {
                if (gameState.isAutoGaining) {
                    // 这里使用baseExpRate而不是expRate，因为gainExp函数会应用倍率
                    gainExp(gameState.baseExpRate);
                }
            }, 1000);
        }
        
        // 绑定按钮点击事件
        elements.expButton.addEventListener('click', () => {
            // 这里使用baseClickExpAmount而不是clickExpAmount，因为gainExp函数会应用倍率
            gainExp(gameState.baseClickExpAmount, true);
            
            // 按钮点击动画
            elements.expButton.classList.add('scale-95');
            setTimeout(() => {
                elements.expButton.classList.remove('scale-95');
            }, 150);
        });
        
        // 绑定自动升级按钮事件
        elements.upgradeAutoButton.addEventListener('click', upgradeAutoExp);
        
        // 绑定点击升级按钮事件
        elements.upgradeClickButton.addEventListener('click', upgradeClickExp);
        
        // 绑定玩家升级按钮事件
        elements.playerUpgradeButton.addEventListener('click', playerUpgrade);
        
        // 初始化游戏
        function initGame() {
            initScenes();
            initBackpack();
            updateExpRates();
            updateUI();
            startAutoExpGain();
            
            // 播放初始场景BGM
            playSceneBgm(scenes[0].bgm);
        }
        
        // 启动游戏
        initGame();
    </script>
</body>
</html>
