            };
            
            for (const [quality, count] of Object.entries(counts)) {
                for (let i = 0; i < count; i++) {
                    const pIndex = i % prefixes[quality].length;
                    const sIndex = Math.floor(i / prefixes[quality].length) % suffixes.length;
                    const iconIndex = i % potionIcons.length;
                    const descIndex = i % descriptions[quality].length;
                    
                    // 确定倍率，品质越高倍率越高
                    let multiplier;
                    switch(quality) {
                        case 'common': multiplier = 1.5; break;
                        case 'rare': multiplier = 3; break;
                        case 'epic': multiplier = 5; break;
                        case 'legend': multiplier = 10; break;
                        case 'mythic': multiplier = 20; break;
