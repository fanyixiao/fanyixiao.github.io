            for (let i = 1; i <= 1000; i++) {
                // 倍率计算公式：从1到2线性增长，1000级达到2倍
                const multiplier = parseFloat((1 + (i - 1) * 1).toFixed(3));
                const bgIndex = (i - 1) % backgrounds.length;
                const bgmIndex = Math.floor(i / 100) % bgmTypes.length;
                
                scenes.push({
                    id: i,
