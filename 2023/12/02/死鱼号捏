                 "红土", "黑石", "白石", "灰石", "沙丘", "草坡", "树丛", "花田", "溪谷", "河岸",
                 "湖畔", "泉边", "洞穴", "山谷", "山坡", "平原", "森林", "草地", "田野", "荒原",
                 "沼泽", "湿地", "沙漠", "戈壁", "山地", "高原", "丘陵", "盆地", "峡谷", "海峡",
                 "岛屿", "半岛", "海湾", "海峡", "河口", "三角洲", "瀑布", "溪流", "湖泊", "河流",
                 "冰川", "雪峰", "火山", "温泉", "森林", "丛林", "雨林", "针叶林", "阔叶林", "灌木林"],
                
                // 中级(101-300)
                ["迷雾", "深邃", "月光", "瀑布", "回音", "荆棘", "古老", "幽暗", "红岩", "风蚀",
                 "水晶", "火山", "冰川", "茂密", "沙漠", "风暴", "黑曜", "魔法", "巨树", "神秘",
